---
import { ProductAppShell } from "../../components/ProductAppShell";
import ProductLayout from "../../layouts/ProductLayout.astro";
import { loadProductPayload } from "../../lib/payload";

export function getStaticPaths() {
  const payload = loadProductPayload();
  const caveat = payload.copy.score_fit_caveat || "MCAT/GPA score-screen fit only; not acceptance probability or a school-specific admit chance.";
  const aamcCaveat = payload.copy.aamc_grid_caveat || "AAMC MCAT/GPA grid context is national aggregate data for U.S. MD-granting medical school applicants and acceptees; it is not a school-specific admit chance.";

  return payload.schools.map((school) => ({
    params: { slug: school.slug },
    props: {
      title: `${school.name} / Applicant List`,
      initialPath: `/schools/${school.slug}/`,
      schools: payload.schools,
      caveat,
      aamcCaveat,
      methodology: payload.methodology,
    },
  }));
}

const { title, initialPath, schools, caveat, aamcCaveat, methodology } = Astro.props;
---

<ProductLayout title={title} active="" shellNav={false}>
  <ProductAppShell client:load initialPath={initialPath} schools={schools} caveat={caveat} aamcCaveat={aamcCaveat} methodology={methodology} />
</ProductLayout>
