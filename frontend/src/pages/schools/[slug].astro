---
import ProductLayout from "../../layouts/ProductLayout.astro";
import { loadProductPayload } from "../../lib/payload";
import { buildWhyBullets, formatCurrency, getScoreScreenFit, metricValue, defaultPreferences } from "../../lib/school-utils";

export function getStaticPaths() {
  const payload = loadProductPayload();
  return payload.schools.map((school) => ({
    params: { slug: school.slug },
    props: {
      school,
      caveat: payload.copy.score_fit_caveat || "MCAT/GPA score-screen fit only; not acceptance probability or a school-specific admit chance.",
    },
  }));
}

const { school, caveat } = Astro.props;
const whyBullets = buildWhyBullets(school);
const fit = getScoreScreenFit(school, defaultPreferences);
---

<ProductLayout title={`${school.name} / Applicant List`} active="">
  <section class="profile-header">
    <div>
      <p class="eyebrow">{school.degree} / {school.city}, {school.stateAbbrev || school.state}</p>
      <h1>{school.name}</h1>
      <p>{caveat}</p>
    </div>
    <div class="rank-pill large">
      <span>{school.rankLabel}</span>
      <strong>{school.decisionRank ? `#${school.decisionRank}` : "Unranked"}</strong>
    </div>
  </section>

  <section class="profile-grid">
    <article class="profile-section">
      <h2>Score-screen Context</h2>
      <span class={`fit-chip ${fit.category}`}>{fit.label}</span>
      <dl class="profile-metrics">
        <div>
          <dt>Published MCAT</dt>
          <dd>{metricValue(school.schoolMcat || school.publishedMcatBand)}</dd>
        </div>
        <div>
          <dt>Published GPA</dt>
          <dd>{metricValue(school.schoolGpa || school.publishedGpaBand)}</dd>
        </div>
        <div>
          <dt>MCAT/GPA source quality</dt>
          <dd>{school.statsQuality || "Not available"}</dd>
        </div>
      </dl>
    </article>

    <article class="profile-section">
      <h2>Cost Context</h2>
      <dl class="profile-metrics">
        <div>
          <dt>Estimated in-state COA</dt>
          <dd>{formatCurrency(school.costInState)}</dd>
        </div>
        <div>
          <dt>Estimated out-of-state COA</dt>
          <dd>{formatCurrency(school.costOutState)}</dd>
        </div>
        <div>
          <dt>Cost source confidence</dt>
          <dd>{school.costConfidence || "Not available"}</dd>
        </div>
      </dl>
    </article>

    <article class="profile-section wide">
      <h2>Why It Ranks Here</h2>
      <ul>
        {whyBullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </article>

    <article class="profile-section">
      <h2>Data Status</h2>
      <dl class="profile-metrics">
        <div>
          <dt>Rank confidence</dt>
          <dd>{school.rankConfidence || "provisional"}</dd>
        </div>
        <div>
          <dt>Admissions policies</dt>
          <dd>{school.policyCount}</dd>
        </div>
        <div>
          <dt>Letter rows</dt>
          <dd>{school.letterCount}</dd>
        </div>
      </dl>
    </article>

    <article class="profile-section">
      <h2>Source</h2>
      <p>{school.sourceName || "Source name not available in payload."}</p>
      {school.sourceUrl ? <a class="action-link" href={school.sourceUrl}>Open source</a> : null}
    </article>
  </section>
</ProductLayout>
