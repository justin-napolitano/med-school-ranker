---
import ProductLayout from "../layouts/ProductLayout.astro";
import { loadProductPayload } from "../lib/payload";

const payload = loadProductPayload();
const caveat = payload.copy.score_fit_caveat || "MCAT/GPA score-screen fit only; not acceptance probability or a school-specific admit chance.";
const aamcCaveat = payload.copy.aamc_grid_caveat || "AAMC MCAT/GPA grid context is national aggregate data for U.S. MD-granting medical school applicants and acceptees; it is not a school-specific admit chance.";
const methodology = payload.methodology.slice(0, 12);
---

<ProductLayout title="Methodology / Applicant List" active="/methodology/">
  <section class="page-header">
    <p class="eyebrow">Transparent scoring</p>
    <h1>Methodology</h1>
    <p>The app uses generated deterministic data and browser-local preferences. It does not run a predictive admissions model.</p>
  </section>

  <section class="methodology-grid">
    <article class="method-card">
      <h2>Score-screen fit</h2>
      <p>{caveat}</p>
      <p>Labels compare applicant MCAT/GPA inputs with generated school MCAT/GPA averages or bands when those fields are available.</p>
    </article>
    <article class="method-card">
      <h2>Ranking context</h2>
      <p>Rank explanations come from generated ranking summaries, drivers, source-confidence flags, and missing-data fields.</p>
      <p>Blank or provisional fields stay visible instead of becoming implied evidence.</p>
    </article>
    <article class="method-card">
      <h2>AAMC grid context</h2>
      <p>{aamcCaveat}</p>
    </article>
  </section>

  <section class="methodology-list" aria-label="Generated scoring rows">
    <div class="feed-heading">
      <div>
        <p class="eyebrow">Generated rows</p>
        <h2>Scoring inputs shown in this build</h2>
      </div>
      <div class="count-block">
        <strong>{payload.methodology.length}</strong>
        <span>rows</span>
      </div>
    </div>
    <div class="method-row-list">
      {
        methodology.map((row) => (
          <article class="method-row">
            <h3>{row.display_label || row.methodology_area || "Scoring row"}</h3>
            <p>{row.notes || row.formula_reference || "Generated scoring definition."}</p>
            <span>{row.methodology_area || "Methodology"}</span>
          </article>
        ))
      }
    </div>
  </section>
</ProductLayout>
