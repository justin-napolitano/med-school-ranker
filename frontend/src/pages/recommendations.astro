---
import ProductLayout from "../layouts/ProductLayout.astro";
import { loadProductPayload } from "../lib/payload";

const payload = loadProductPayload();
const caveat = payload.copy.score_fit_caveat || "MCAT/GPA score-screen fit only; not acceptance probability or a school-specific admit chance.";
---

<ProductLayout title="Build My List / Applicant List" active="/">
  <section class="page-header">
    <p class="eyebrow">Merged surface</p>
    <h1>Build My List is the recommendation surface</h1>
    <p>{caveat}</p>
  </section>
  <section class="empty-state">
    <h2>Use one list-building workspace</h2>
    <p>
      The previous recommendations view duplicated Build My List. Use Build My List for ranked cards, filters,
      score-screen context, and Interested/Applying actions.
    </p>
    <a class="action-link" href="/">Open Build My List</a>
  </section>
</ProductLayout>
