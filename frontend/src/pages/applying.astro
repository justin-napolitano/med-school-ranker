---
import { LocalListPage } from "../components/LocalListPage";
import ProductLayout from "../layouts/ProductLayout.astro";
import { loadProductPayload } from "../lib/payload";

const payload = loadProductPayload();
const caveat = payload.copy.score_fit_caveat || "MCAT/GPA score-screen fit only; not acceptance probability or a school-specific admit chance.";
---

<ProductLayout title="Applying / Applicant List" active="/applying/">
  <section class="page-header">
    <p class="eyebrow">Final list</p>
    <h1>Applying</h1>
    <p>Browser-local application list with a 25 school cap. {caveat}</p>
  </section>
  <LocalListPage client:load schools={payload.schools} caveat={caveat} listType="applying" />
</ProductLayout>
