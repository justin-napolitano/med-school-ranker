---
import "../styles/global.css";
import { withBase } from "../lib/site-url";

type NavItem = {
  href: string;
  label: string;
  admin?: boolean;
};

const {
  title = "Applicant List",
  description = "Static applicant product frontend for generated medical school ranking data.",
  active = "/",
  surface = "product",
  shellNav = true,
} = Astro.props;

const navItems: NavItem[] = [
  { href: "/", label: "Build My List" },
  { href: "/schools/", label: "Schools" },
  { href: "/interested/", label: "Interested" },
  { href: "/applying/", label: "Applying" },
  { href: "/not-interested/", label: "Not Interested" },
  { href: "/compare/", label: "Compare" },
  { href: "/scoring/", label: "Scoring" },
  { href: "/methodology/", label: "Methodology" },
  { href: "/admin/", label: "Admin/Data", admin: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body data-surface={surface}>
    <div class="app-shell">
      <header class="topbar">
        <a class="brand" href={withBase("/")} aria-label="Applicant List home">
          <span class="brand-mark" aria-hidden="true">AL</span>
          <span>Applicant List</span>
        </a>
        {
          shellNav ? (
            <nav class="primary-nav" aria-label="Primary">
              {navItems.map((item) => (
                <a class:list={["nav-link", item.admin && "admin-link", active === item.href && "active"]} href={withBase(item.href)}>
                  {item.label}
                </a>
              ))}
            </nav>
          ) : null
        }
      </header>
      <main class="page-frame">
        <slot />
      </main>
    </div>
  </body>
</html>
